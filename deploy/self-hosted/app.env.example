# Template only. The server preparer creates the real file with mode 0600.
# Do not commit or print the completed file, or rendered Compose configuration.
# Use one combined private environment, or load the generated Supabase environment
# BEFORE a separate copy of this app environment.

AGSAAS_SOURCE_DIR=/opt/agsaas/source
# Full application Git commit; the same immutable release is used by all images.
AGSAAS_RELEASE=
# Choose the approved Redis reference and record its resolved digest. The repo's
# Redis integration tests use the 7.4 line; do not substitute an untested latest.
AGSAAS_REDIS_IMAGE=
# Required ONLY when explicitly adding compose.mail-test.yml. The preparer pins
# a verified caddy:2-alpine digest; it is a private template server, not ingress.
# AGSAAS_CADDY_IMAGE=

# Private stage URLs: access all three through matching SSH local port forwards.
# Public production requires new HTTPS URLs and a rebuilt dashboard image.
AGSAAS_DASHBOARD_URL=http://localhost:3300
AGSAAS_API_URL=http://localhost:3303

# Server-only, comma-separated exact HTTP proxy IPs, observed at the Bun socket.
# Blank trusts no proxy. No CIDR, hostnames, wildcards or automatic private ranges.
# Confirm proxy-only access and the NAT path before enabling; see
# docs/trusted-proxy-boundary-20261103.md. These are not Postmark sender IPs.
AGSAAS_TRUSTED_PROXY_IPS=

# Provision agsaas_app first; never use the postgres/supabase_admin runtime role.
# URL-encode credentials. These examples use an isolated same-host Docker network,
# not an externally exposed database. No passwords are provided by this template.
# Direct: postgresql://agsaas_app:<password>@db:5432/postgres?sslmode=disable
AGSAAS_DATABASE_URL=
# Transaction pooler: postgresql://agsaas_app.agsaas-stage:<password>@supavisor:6543/postgres?sslmode=disable
# Must match POOLER_TENANT_ID=agsaas-stage in the generated Supabase environment.
AGSAAS_WORKER_DATABASE_URL=

# Independently generated, persistent 64-character hex values. Hex is required
# for these Redis passwords because the overlay inserts them into Redis URLs.
REDIS_CACHE_PASSWORD=
REDIS_QUEUE_PASSWORD=
INTERNAL_API_KEY=
MIDDAY_ENCRYPTION_KEY=
FILE_KEY_SECRET=
INVOICE_JWT_SECRET=
# Canonical base64 of 32 random bytes; retain and use the same value at build/runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

AGSAAS_WORKER_ENV=staging
INSIGHTS_ENABLED=false
# Optional ISO timestamp only when an explicit signup cutoff is wanted:
# NEW_USER_SIGNUP_CUTOFF=

# Comma-separated enabled login methods: email,password,google,apple,azure,github.
# Enable only providers that are configured in your own Supabase Auth instance.
# Password requires explicitly provisioned accounts; it does not enable signup.
AUTH_ENABLED_PROVIDERS=email
# Opt in only after real GoTrue SMTP and the exact recovery redirect are configured.
AUTH_PASSWORD_RECOVERY_ENABLED=false

# Stable installation cookie namespace; build and runtime must match.
# Leave absent on an existing installation until a planned session/logout rollout.
# Mandatory and distinct for a second installation sharing the same host/IP.
NEXT_PUBLIC_AUTH_COOKIE_NAME=

# Intentionally NOT duplicated here: the official generated Supabase environment
# supplies SUPABASE_PUBLIC_URL, API_EXTERNAL_URL, SITE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, JWT_SECRET, JWT_KEYS, JWT_JWKS, ANON_KEY_ASYMMETRIC,
# SERVICE_ROLE_KEY_ASYMMETRIC, POOLER_TENANT_ID and the platform's other secrets.
# Stage values must be:
# SUPABASE_PUBLIC_URL=http://localhost:3800
# API_EXTERNAL_URL=http://localhost:3800/auth/v1
# SITE_URL=http://localhost:3300
# No SMTP/provider credentials are invented, and email auto-confirm stays disabled.

# Product email delivery (invoices and team invitations), separate from Auth SMTP.
# Use your own verified sender and provider key. Missing settings remain explicit.
RESEND_API_KEY=
EMAIL_FROM=
APP_NAME=AGSaaS

# Own product email identity (Resend is separate from GoTrue Auth SMTP).
EMAIL_REPLY_TO=
EMAIL_REVIEW_TO=

# Inbox OAuth. Use the exact API origin, e.g. https://api.example/apps/gmail/oauth-callback.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=

# Optional SaaS subscriptions. Own Polar products are mandatory before enabling.
AGSAAS_BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_STARTER_YEARLY_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
PLAIN_API_KEY=
PLAIN_SUPPORT_LABEL_ID=

# Optional label owned by your Plain workspace for feedback requests.
PLAIN_FEEDBACK_LABEL_ID=

# Native banking: configure only approved providers; never copy credentials to a synthetic candidate.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=
TELLER_CERT_BASE64=
TELLER_KEY_BASE64=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=
