{
  "name": "@midday/job-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:native-wakeup": "bun --no-env-file test --exit src/native-wakeup.test.ts",
    "test": "bun run test:native-wakeup && bun run test:admission",
    "test:admission": "bun --no-env-file test --exit src/queued-admission-protocol.test.ts",
    "test:admission:redis": "bun --no-env-file test --exit --timeout 30000 src/resource-admission.test.ts src/retry-inbox-job.test.ts"
  },
  "dependencies": {
    "@midday/logger": "workspace:*",
    "bullmq": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./resource-admission": "./src/resource-admission.ts",
    "./*": "./src/*.ts",
    "./native-wakeup": "./src/native-wakeup.ts"
  }
}
