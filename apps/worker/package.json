{
  "name": "@midday/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --exit src/http src/runtime && bun run test:startup && bun run test:error-classification && bun run test:base && bun run test:import-transactions && bun run test:recurring-template && bun run test:invoice-delivery",
    "test:startup": "bun --no-env-file test --exit --timeout 30000 src/processors/teams/payment-issue.test.ts",
    "test:error-classification": "bun --no-env-file test --exit --timeout 30000 src/utils/error-classification.test.ts src/processors/retry-test-connection.test.ts",
    "test:base": "bun --no-env-file test --exit --timeout 30000 src/processors/base.test.ts",
    "test:import-transactions": "bun --no-env-file test --exit --timeout 30000 src/processors/transactions/import-transactions.test.ts",
    "test:recurring-template": "bun --no-env-file test --exit src/utils/invoice-template-builder.test.ts",
    "test:invoice-delivery": "bun --no-env-file test --exit --timeout 30000 src/processors/invoices/invoice-email-delivery.test.ts && bun --no-env-file test --exit src/processors/invoices/invoice-delivery-operation.test.ts && bun --no-env-file test --exit --timeout 30000 src/processors/invoices/reconcile-invoice-deliveries.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@fast-csv/format": "catalog:",
    "@hono/node-server": "^1.19.11",
    "@midday/accounting": "workspace:*",
    "@midday/app-store": "workspace:*",
    "@midday/banking": "workspace:*",
    "@midday/bot": "workspace:*",
    "@midday/cache": "workspace:*",
    "@midday/customers": "workspace:*",
    "@midday/db": "workspace:*",
    "@midday/documents": "workspace:*",
    "@midday/email": "workspace:*",
    "@midday/health": "workspace:*",
    "@midday/import": "workspace:*",
    "@midday/insights": "workspace:*",
    "@midday/invoice": "workspace:*",
    "@midday/job-client": "workspace:*",
    "@midday/jobs": "workspace:*",
    "@midday/location": "workspace:*",
    "@midday/logger": "workspace:*",
    "@midday/notifications": "workspace:*",
    "@midday/supabase": "workspace:*",
    "@midday/trpc": "workspace:*",
    "@midday/utils": "workspace:*",
    "@sentry/bun": "catalog:",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bullmq": "catalog:",
    "camelcase-keys": "^10.0.2",
    "date-fns": "catalog:",
    "heic-convert": "catalog:",
    "hono": "catalog:",
    "node-xlsx": "catalog:",
    "papaparse": "catalog:",
    "sharp": "catalog:",
    "workbench": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/heic-convert": "1.2.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14"
  }
}
